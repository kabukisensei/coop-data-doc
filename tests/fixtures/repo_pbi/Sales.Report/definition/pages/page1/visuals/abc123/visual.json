{
  "$schema": "https://developer.microsoft.com/json-schemas/fabric/item/report/definition/visualContainer/1.0.0/schema.json",
  "name": "abc123",
  "position": { "x": 0, "y": 0, "width": 300, "height": 200 },
  "visual": {
    "visualType": "card",
    "query": {
      "queryState": {
        "Values": {
          "projections": [
            {
              "field": { "Measure": { "Expression": { "SourceRef": { "Entity": "dim_customer" } }, "Property": "Customer Count" } },
              "queryRef": "dim_customer.Customer Count"
            }
          ]
        }
      }
    }
  },
  "filterConfig": {
    "filters": [
      {
        "name": "visualFilter",
        "field": { "Column": { "Expression": { "SourceRef": { "Entity": "fact_sales" } }, "Property": "order_id" } },
        "type": "Categorical"
      }
    ]
  }
}
