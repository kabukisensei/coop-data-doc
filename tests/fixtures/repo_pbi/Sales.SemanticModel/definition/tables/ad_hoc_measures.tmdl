table 'Ad Hoc Measures'
	lineageTag: 88888888-8888-8888-8888-888888888888

	measure 'KPI Total' = [Total Sales] + [Customer Count]
		formatString: $ #,0
		lineageTag: 99999999-9999-9999-9999-999999999999

	measure Forecast = 'Ad Hoc Measures'[KPI Total] * 1.1
		formatString: $ #,0
		lineageTag: 99999999-9999-9999-9999-999999999998

	measure 'Sales Plan' = dim_customer[Total Sales] + SUM(fact_sales[order_total])
		formatString: $ #,0
		lineageTag: 99999999-9999-9999-9999-999999999997

	column RowNumber
		dataType: int64
		isHidden: true
		lineageTag: aaaaaaaa-0000-0000-0000-000000000000
		summarizeBy: none
		sourceColumn: RowNumber
