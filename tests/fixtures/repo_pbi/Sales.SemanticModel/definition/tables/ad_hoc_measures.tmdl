table 'Ad Hoc Measures'
	lineageTag: 88888888-8888-8888-8888-888888888888

	measure 'KPI Total' = [Total Sales] + [Customer Count]
		formatString: $ #,0
		lineageTag: 99999999-9999-9999-9999-999999999999

	column RowNumber
