table dim_customer
	lineageTag: 11111111-1111-1111-1111-111111111111

	measure 'Customer Count' = COUNTROWS(dim_customer)
		formatString: #,0
		lineageTag: 22222222-2222-2222-2222-222222222222

	column customer_id
		dataType: int64
		summarizeBy: none
		sourceColumn: customer_id
		lineageTag: 33333333-3333-3333-3333-333333333333

	column customer_name
		dataType: string
		summarizeBy: none
		sourceColumn: customer_name
		lineageTag: 44444444-4444-4444-4444-444444444444

	partition dim_customer = m
		mode: import
		source =
				let
				    Source = Sql.Database("myserver.database.windows.net", "gold"),
				    sales_dim_customer = Source{[Schema="sales",Item="dim_customer"]}[Data]
				in
				    sales_dim_customer
